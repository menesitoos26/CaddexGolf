# Copia este fichero a docker/.env antes de levantar los contenedores.
# docker compose lo lee automáticamente.

# Dominio público desde el que se sirve la aplicación.
#
# Es la ÚNICA fuente de verdad: de aquí salen el server_name de Nginx y la
# ruta del certificado. Para migrar a otro dominio basta con cambiar esta
# línea (y tener su certificado emitido) y reiniciar los contenedores.
#
# Debe existir /etc/letsencrypt/live/<DOMINIO>/fullchain.pem en el servidor.
DOMINIO=caddexgolf.duckdns.org

# Clave de firma de los tokens JWT (mínimo 32 caracteres).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Credenciales de MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=golf_db
MYSQL_USER=golf_user
MYSQL_PASSWORD=

ENVIRONMENT=production

# En producción el frontend y la API van tras el mismo dominio, así que
# no hace falta CORS. Déjalo vacío salvo que sirvas la web desde otro origen.
CORS_ORIGINS=

# Opcional: clave de la API externa de campos de golf.
GOLF_COURSE_API_KEY=

# --------------------------------------------------- correo (restablecimiento)
#
# Sin SMTP_HOST la aplicación NO envía correos: escribe el enlace en el log del
# backend. Sirve para probar el flujo, pero en producción los jugadores que
# olviden su contraseña se quedarían sin poder recuperarla.
#
# Con Gmail: activa la verificación en 2 pasos y genera una "contraseña de
# aplicación" (Cuenta de Google -> Seguridad). La contraseña normal no vale.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_REMITENTE=Caddex Golf <no-responder@caddexgolf.com>

# Dirección pública para los enlaces del correo.
# Por defecto https://$DOMINIO, así que normalmente no hace falta tocarla.
#APP_BASE_URL=
